{
  "sourceLanguage": "en",
  "strings": {
    "smb_error_unreachable": {
      "comment": "Error message when SMB server cannot be reached",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server „%@“ ist nicht erreichbar. Bitte stelle sicher, dass der Server eingeschaltet und mit dem lokalen Netzwerk verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server '%@' is unreachable. Please verify that the server is powered on and connected to the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor «%@» no está accesible. Comprueba que el servidor esté encendido y conectado a la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur « %@ » est inaccessible. Vérifiez qu’il est allumé et connecté au réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server '%@' non è raggiungibile. Verifica che il server sia acceso e connesso alla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ“%@”にアクセスできません。サーバの電源が入っており、ローカルネットワークに接続されていることを確認してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server '%@' is niet bereikbaar. Controleer of de server is ingeschakeld en verbonden is met het lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer „%@” jest nieosiągalny. Upewnij się, że serwer jest włączony i podłączony do sieci lokalnej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor «%@» está inacessível. Verifique se o servidor está ligado e conectado à rede local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器“%@”无法访问。请验证该服务器已开机并连接至局域网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接伺服器「%@」。請確認伺服器已開啟電源並已連接至區域網路。"
          }
        }
      }
    },
    "smb_error_bad_credentials": {
      "comment": "Error message when SMB authentication fails due to incorrect credentials",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung fehlgeschlagen. Der angegebene Benutzername oder das Passwort ist falsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. The username or password provided is incorrect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación. El nombre de usuario o la contraseña no son correctos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification. Le nom d’utilisateur ou le mot de passe fourni est incorrect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita. Il nome utente o la password inseriti non sono corretti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました。指定されたユーザ名またはパスワードが正しくありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticatie mislukt. De opgegeven gebruikersnaam of het wachtwoord is onjuist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie nie powiodło się. Podana nazwa użytkownika lub hasło są nieprawidłowe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação falhou. O nome de utilizador ou palavra-passe fornecida está incorreta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证失败。提供的用户名或密码不正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認證失敗。所提供的使用者名稱或密碼不正確。"
          }
        }
      }
    },
    "smb_error_timeout": {
      "comment": "Error message when SMB connection times out",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung der Verbindung. Der Server hat zu lange gebraucht, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection timed out. The server took too long to respond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de conexión agotado. El servidor ha tardado demasiado en responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de connexion dépassé. Le serveur a mis trop de temps à répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione scaduta. Il server ha impiegato troppo tempo per rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がタイムアウトしました。サーバの応答に時間がかかりすぎています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindingstime-out. De server deed er te lang over om te antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit czasu połączenia. Serwer zbyt długo nie odpowiadał."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo de ligação esgotado. O servidor demorou demasiado tempo a responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时。服务器响应时间过长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線逾時。伺服器回應時間過長。"
          }
        }
      }
    },
    "smb_error_no_shares": {
      "comment": "Error message when no shared folders are available on SMB server",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server wurden keine freigegebenen Ordner gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared folders were found on this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado carpetas compartidas en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier partagé n’a été trouvé sur ce serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cartella condivisa trovata su questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバ上で共有フォルダが見つかりませんでした。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen gedeelde mappen gevonden op deze server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym serwerze nie znaleziono udostępnionych folderów."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas pastas partilhadas neste servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器上未找到共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器上找不到共享檔案夾。"
          }
        }
      }
    },
    "smb_error_share_not_found": {
      "comment": "Error message when specified SMB share does not exist",
      "extractionState": "manual",
      "localizations": {
